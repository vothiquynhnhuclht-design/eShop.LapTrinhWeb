@using eShop.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization

<Router AdditionalAssemblies="new[] { 
        typeof(eShop.Web.CustomerPortal.Pages.SearchProductComponent).Assembly,
        typeof(eShop.Web.AdminPortal.OutstandingOrdersComponent).Assembly
    }" AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView DefaultLayout="@typeof(MainLayout)" RouteData="@routeData">
            <NotAuthorized>
                <div class="beauty-container py-5">
                    <div class="beauty-card p-5 text-center max-w-600 mx-auto">
                        <div class="mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center"
                                 style="width: 72px; height: 72px; background-color: var(--color-danger-bg); border-radius: 50%;">
                                <i class="bi bi-shield-x fs-1" style="color: var(--color-danger);"></i>
                            </div>
                        </div>
                        <span class="badge badge-beauty mb-2">Restricted Access</span>
                        <h2 class="font-serif fs-3 mb-2">Administrator Access Required</h2>
                        <p class="text-secondary mb-4">
                            You must be authenticated with administrator credentials to view this section.
                        </p>
                        <div>
                            <NavLink href="login" class="btn-beauty-primary btn-beauty-lg text-decoration-none">
                                <i class="bi bi-person-lock me-2"></i> Sign In as Administrator
                            </NavLink>
                        </div>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
    <NotFound>
        <PageTitle>Page Not Found - eShop</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="beauty-container py-5">
                <div class="beauty-card p-5 text-center max-w-600 mx-auto my-5">
                    <h1 class="font-serif display-4 text-muted mb-3">404</h1>
                    <h3 class="font-serif fs-3 mb-2">Page Not Found</h3>
                    <p class="text-secondary mb-4">
                        We couldn't find the page or formula you were looking for.
                    </p>
                    <NavLink href="" class="btn-beauty-primary text-decoration-none">
                        <i class="bi bi-house me-2"></i> Return to Home
                    </NavLink>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>

<style>
    .max-w-600 {
        max-width: 600px;
    }
</style>
