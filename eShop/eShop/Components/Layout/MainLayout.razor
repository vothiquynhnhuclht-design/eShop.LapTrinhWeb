@inherits LayoutComponentBase
@using eShop.Web.Common.Controls

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="me-3">About</a>
                <AuthorizeView>
                    <Authorized>
                        <span class="text-secondary small me-2">Hello, <strong>@context.User.Identity?.Name</strong></span>
                        <a href="/logout" class="btn btn-outline-danger btn-sm py-0 px-2">Logout</a>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="login" class="btn btn-outline-primary btn-sm py-0 px-2">Login</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
            <div>
                <CartCountComponent />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
