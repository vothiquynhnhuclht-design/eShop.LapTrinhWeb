@implements IDisposable
@using eShop.UseCases.PluginInterfaces.StateStore
@inject IShoppingCartStateStore shoppingCartStateStore

<NavLink href="cart" class="btn-beauty-outline btn-beauty-sm d-inline-flex align-items-center position-relative text-decoration-none" title="View Shopping Bag">
    <i class="bi bi-bag me-1 fs-6"></i>
    <span class="d-none d-sm-inline">Bag</span>
    @if (count > 0)
    {
        <span class="beauty-cart-badge">
            @count
        </span>
    }
</NavLink>

@code {
    private int count = 0;

    protected override async Task OnInitializedAsync()
    {
        shoppingCartStateStore.AddStateChangeListeners(HandleStateChange);
        count = await shoppingCartStateStore.GetLineItemsCount();
    }

    private async void HandleStateChange()
    {
        count = await shoppingCartStateStore.GetLineItemsCount();
        StateHasChanged();
    }

    public void Dispose()
    {
        shoppingCartStateStore.RemoveStateChangeListeners(HandleStateChange);
    }
}
