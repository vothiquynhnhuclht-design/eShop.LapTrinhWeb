<div class="row g-2 align-items-center" style="max-width: 500px;">
    <div class="col">
        <input type="text" class="form-control" id="filter" placeholder="Search product name..." @bind-value="filter" @onkeyup="HandleKeyUp" />
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-primary px-4" @onclick="HandleSearch">Search</button>
    </div>
</div>

@code {
    private string filter = string.Empty;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private void HandleSearch()
    {
        OnSearch.InvokeAsync(filter);
    }

    private void HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSearch();
        }
    }
}
