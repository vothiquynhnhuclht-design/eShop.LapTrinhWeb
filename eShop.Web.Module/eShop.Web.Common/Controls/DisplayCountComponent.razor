@implements IDisposable
@using eShop.UseCases.PluginInterfaces.StateStore
@inject IShoppingCartStateStore shoppingCartStateStore

<NavLink href="cart" class="nav-link text-decoration-none d-inline-flex align-items-center position-relative">
    <i class="bi bi-cart3 fs-5 me-1"></i> Cart
    @if (count > 0)
    {
        <span class="badge bg-danger rounded-pill ms-2">
            @count
        </span>
    }
</NavLink>

@code {
    private int count = 0;

    protected override async Task OnInitializedAsync()
    {
        shoppingCartStateStore.AddStateChangeListeners(HandleStateChange);
        count = await shoppingCartStateStore.GetLineItemsCount();
    }

    private async void HandleStateChange()
    {
        count = await shoppingCartStateStore.GetLineItemsCount();
        StateHasChanged();
    }

    public void Dispose()
    {
        shoppingCartStateStore.RemoveStateChangeListeners(HandleStateChange);
    }
}
