@page "/outstandingorders"
@page "/admin/orders"
@page "/admin"
@attribute [Authorize]
@inject IViewOutstandingOrdersUseCase viewOutstandingOrdersUseCase

<div class="beauty-container py-4">
    <!-- Header Row -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 pb-2 border-bottom border-secondary border-opacity-10">
        <div>
            <span class="badge badge-brand mb-2"><i class="bi bi-shield-lock me-1"></i> Admin Operations</span>
            <h1 class="font-serif fs-2 mb-0">Outstanding Orders</h1>
        </div>
        <div>
            <span class="badge badge-beauty fs-6">
                <i class="bi bi-hourglass-split me-1"></i> @(orders?.Count() ?? 0) Pending Orders
            </span>
        </div>
    </div>

    @if (orders != null && orders.Any())
    {
        <div class="beauty-card overflow-hidden shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: var(--color-surface-subdued);">
                        <tr>
                            <th class="ps-4 py-3">Order ID</th>
                            <th class="py-3">Reference ID</th>
                            <th class="py-3">Date Placed</th>
                            <th class="py-3">Customer</th>
                            <th class="py-3">Location</th>
                            <th class="text-center py-3">Items</th>
                            <th class="text-end py-3">Total Amount</th>
                            <th class="text-center pe-4 py-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@order.OrderId</td>
                                <td><span class="badge bg-dark font-monospace">@order.UniqueId</span></td>
                                <td class="small text-secondary">@order.DatePlaced?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-semibold">@order.CustomerName</td>
                                <td class="small text-secondary">@order.CustomerCity, @order.CustomerCountry</td>
                                <td class="text-center">
                                    <span class="badge badge-brand">@order.TotalItems</span>
                                </td>
                                <td class="text-end fw-bold font-serif fs-6">@order.TotalPrice.ToString("c")</td>
                                <td class="text-center pe-4">
                                    <NavLink href="@($"/orderdetail/{order.OrderId}")" class="btn-beauty-primary btn-beauty-sm text-decoration-none">
                                        <i class="bi bi-gear-fill me-1"></i> Process
                                    </NavLink>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="beauty-card p-5 text-center my-4">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center"
                     style="width: 70px; height: 70px; background-color: var(--color-success-bg); border-radius: 50%;">
                    <i class="bi bi-check2-all fs-2" style="color: var(--color-success);"></i>
                </div>
            </div>
            <h4 class="font-serif mb-2">No Outstanding Orders</h4>
            <p class="text-secondary max-w-400 mx-auto mb-0">
                All customer orders have been successfully processed and fulfilled!
            </p>
        </div>
    }
</div>

<style>
    .max-w-400 {
        max-width: 400px;
    }
</style>

@code {
    private IEnumerable<Order>? orders;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        orders = viewOutstandingOrdersUseCase.Execute();
    }
}
