@page "/outstandingorders"
@page "/admin/orders"
@page "/admin"
@attribute [Authorize]
@inject IViewOutstandingOrdersUseCase viewOutstandingOrdersUseCase

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h3 class="mb-0"><i class="bi bi-list-check me-2"></i> Outstanding Orders</h3>
        <span class="badge bg-primary fs-6">@(orders?.Count() ?? 0) Orders Pending</span>
    </div>

    @if (orders != null && orders.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order ID</th>
                            <th>Reference ID</th>
                            <th>Date Placed</th>
                            <th>Customer Name</th>
                            <th>City, Country</th>
                            <th class="text-center">Items</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td class="fw-bold">#@order.OrderId</td>
                                <td><span class="badge bg-dark font-monospace">@order.UniqueId</span></td>
                                <td>@order.DatePlaced?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.CustomerName</td>
                                <td>@order.CustomerCity, @order.CustomerCountry</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@order.TotalItems</span>
                                </td>
                                <td class="text-end fw-bold text-danger">@order.TotalPrice.ToString("c")</td>
                                <td class="text-center">
                                    <NavLink href="@($"/orderdetail/{order.OrderId}")" class="btn btn-primary btn-sm">
                                        <i class="bi bi-gear-fill me-1"></i> Process
                                    </NavLink>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 p-5 text-center my-4">
            <div class="mb-3 text-success">
                <i class="bi bi-check2-all" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-secondary mb-2">No Outstanding Orders</h4>
            <p class="text-muted mb-0">All customer orders have been processed successfully!</p>
        </div>
    }
</div>

@code {
    private IEnumerable<Order>? orders;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        orders = viewOutstandingOrdersUseCase.Execute();
    }
}
