@page "/orderdetail/{orderId:int}"
@attribute [Authorize]
@using eShop.CoreBusiness.Models
@using eShop.UseCases.AdminPortal.OrderDetailScreen
@using eShop.Web.CustomerPortal.Controls
@using Microsoft.AspNetCore.Components.Authorization
@inject IViewOrderDetailUseCase viewOrderDetailUseCase
@inject IProcessOrderUseCase processOrderUseCase
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider authenticationStateProvider

<div class="beauty-container py-4">
    <!-- Back Button -->
    <div class="mb-4">
        <NavLink href="outstandingorders" class="btn-beauty-outline btn-beauty-sm text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to Outstanding Orders
        </NavLink>
    </div>

    @if (order != null)
    {
        <div class="beauty-card p-4 p-md-5">
            <!-- Order Header & Status -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-10">
                <div>
                    <span class="badge badge-brand mb-2">Order #@order.OrderId</span>
                    <h2 class="font-serif fs-3 mb-0">Order Details Management</h2>
                </div>
                <div>
                    @if (order.DateProcessed.HasValue)
                    {
                        <span class="badge" style="background-color: var(--color-success-bg); color: var(--color-success); font-size: 0.85rem; padding: 0.5rem 1rem;">
                            <i class="bi bi-check-circle-fill me-1"></i> Processed on @order.DateProcessed.Value.ToString("dd/MM/yyyy HH:mm") by @order.AdminUser
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-beauty" style="font-size: 0.85rem; padding: 0.5rem 1rem;">
                            <i class="bi bi-clock-history me-1"></i> Awaiting Processing
                        </span>
                    }
                </div>
            </div>

            <!-- 2 Info Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 rounded" style="background-color: var(--color-surface-subdued);">
                        <div class="text-uppercase fw-bold text-muted extra-small mb-2">Order Summary</div>
                        <div><strong>Order ID:</strong> #@order.OrderId</div>
                        <div class="my-1">
                            <strong>Reference:</strong> <span class="badge bg-dark font-monospace">@order.UniqueId</span>
                        </div>
                        <div class="small text-secondary">
                            <strong>Date Placed:</strong> @order.DatePlaced?.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded" style="background-color: var(--color-surface-subdued);">
                        <div class="text-uppercase fw-bold text-muted extra-small mb-2">Shipping Information</div>
                        <div class="fw-semibold">@order.CustomerName</div>
                        <div class="small text-secondary">@order.CustomerAddress, @order.CustomerCity</div>
                        <div class="small text-secondary">@order.CustomerStateProvince, @order.CustomerCountry</div>
                    </div>
                </div>
            </div>

            <!-- Items -->
            <h5 class="font-serif fs-5 mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                Purchased Items List
            </h5>
            <div class="mb-4">
                <OrderLineItemsComponent LineItems="order.LineItems" />
            </div>

            <!-- Total Amount -->
            <div class="d-flex justify-content-between align-items-baseline p-3 rounded mb-4" style="background-color: var(--color-surface-subdued);">
                <span class="fw-bold fs-6">Total Amount:</span>
                <span class="fw-bold fs-3 text-dark font-serif">@order.TotalPrice.ToString("c")</span>
            </div>

            <!-- Process Action Button -->
            @if (!order.DateProcessed.HasValue)
            {
                <div class="text-end pt-2">
                    <button class="btn-beauty-primary btn-beauty-lg" @onclick="HandleProcessOrder">
                        <i class="bi bi-check2-circle me-2"></i> Confirm & Mark as Processed
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="beauty-card p-5 text-center my-4">
            <h4 class="font-serif text-danger mb-2">Order Not Found</h4>
            <p class="text-secondary mb-4">Order #@orderId could not be located in the database.</p>
            <NavLink href="outstandingorders" class="btn-beauty-primary">
                Return to Orders
            </NavLink>
        </div>
    }
</div>

<style>
    .extra-small {
        font-size: 0.7rem;
        letter-spacing: 0.08em;
    }
</style>

@code {
    [Parameter]
    public int orderId { get; set; }

    private Order? order;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        order = viewOrderDetailUseCase.Execute(orderId);
    }

    private async Task HandleProcessOrder()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        var adminUserName = authState.User.Identity?.Name ?? "Admin";

        if (processOrderUseCase.Execute(orderId, adminUserName))
        {
            navigationManager.NavigateTo("/outstandingorders");
        }
    }
}
