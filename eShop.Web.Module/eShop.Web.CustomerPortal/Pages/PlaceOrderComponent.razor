@page "/placeorder"
@page "/checkout"
@using eShop.CoreBusiness.Models
@using eShop.UseCases.OrderConfirmationScreen
@using eShop.UseCases.ShoppingCartScreen
@using eShop.Web.CustomerPortal.Controls
@inject IViewShoppingCartUseCase viewShoppingCartUseCase
@inject IPlaceOrderUseCase placeOrderUseCase
@inject NavigationManager navigationManager

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h3 class="mb-0">Checkout & Place Order</h3>
        <NavLink href="cart" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Cart
        </NavLink>
    </div>

    @if (order != null && order.LineItems != null && order.LineItems.Count > 0)
    {
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 p-4">
                    <h5 class="card-title fw-bold mb-3 border-bottom pb-2">Customer Information</h5>
                    <EditForm Model="order" OnValidSubmit="HandlePlaceOrder">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold">Customer Name</label>
                            <InputText id="name" class="form-control" @bind-Value="order.CustomerName" placeholder="Enter your full name" />
                            <ValidationMessage For="@(() => order.CustomerName)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label for="address" class="form-label fw-semibold">Address</label>
                            <InputText id="address" class="form-control" @bind-Value="order.CustomerAddress" placeholder="123 Street Name" />
                            <ValidationMessage For="@(() => order.CustomerAddress)" class="text-danger small" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label for="city" class="form-label fw-semibold">City</label>
                                <InputText id="city" class="form-control" @bind-Value="order.CustomerCity" placeholder="City" />
                                <ValidationMessage For="@(() => order.CustomerCity)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="province" class="form-label fw-semibold">State / Province</label>
                                <InputText id="province" class="form-control" @bind-Value="order.CustomerStateProvince" placeholder="State/Province" />
                                <ValidationMessage For="@(() => order.CustomerStateProvince)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="country" class="form-label fw-semibold">Country</label>
                            <InputText id="country" class="form-control" @bind-Value="order.CustomerCountry" placeholder="Country" />
                            <ValidationMessage For="@(() => order.CustomerCountry)" class="text-danger small" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold py-2">
                                <i class="bi bi-check-circle me-2"></i> Place Order Now
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm border-0 p-4 mb-4">
                    <h5 class="card-title fw-bold mb-3 border-bottom pb-2">Order Items</h5>
                    <OrderLineItemsComponent LineItems="order.LineItems" />
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="fs-5 fw-bold">Total Amount:</span>
                        <span class="fs-4 fw-bold text-danger">@order.TotalPrice.ToString("c")</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 p-5 text-center my-4">
            <h4 class="text-secondary mb-3">Cannot proceed to checkout</h4>
            <p class="text-muted mb-4">Your shopping cart is empty.</p>
            <div>
                <NavLink href="products" class="btn btn-primary px-4 py-2">
                    Start Shopping
                </NavLink>
            </div>
        </div>
    }
</div>

@code {
    private Order? order;

    protected override async Task OnInitializedAsync()
    {
        order = await viewShoppingCartUseCase.Execute();
    }

    private async Task HandlePlaceOrder()
    {
        if (order != null)
        {
            var uniqueId = await placeOrderUseCase.Execute(order);
            if (!string.IsNullOrEmpty(uniqueId))
            {
                navigationManager.NavigateTo($"/orderconfirm/{uniqueId}");
            }
        }
    }
}
