@page "/placeorder"
@page "/checkout"
@using eShop.CoreBusiness.Models
@using eShop.UseCases.OrderConfirmationScreen
@using eShop.UseCases.ShoppingCartScreen
@using eShop.Web.CustomerPortal.Controls
@inject IViewShoppingCartUseCase viewShoppingCartUseCase
@inject IPlaceOrderUseCase placeOrderUseCase
@inject NavigationManager navigationManager

<div class="beauty-container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-10">
        <div>
            <span class="badge badge-beauty mb-2">Secure Checkout</span>
            <h1 class="font-serif fs-2 mb-0">Complete Your Order</h1>
        </div>
        <NavLink href="cart" class="btn-beauty-outline btn-beauty-sm text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Return to Bag
        </NavLink>
    </div>

    @if (order != null && order.LineItems != null && order.LineItems.Count > 0)
    {
        <div class="row g-4">
            <!-- Left: Checkout Shipping Form -->
            <div class="col-lg-7">
                <div class="beauty-card p-4 p-md-5">
                    <h4 class="font-serif fs-5 mb-4 pb-2 border-bottom border-secondary border-opacity-10">
                        <i class="bi bi-geo-alt me-2 text-accent"></i> Shipping & Contact Details
                    </h4>

                    <EditForm Model="order" OnValidSubmit="HandlePlaceOrder">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="name" class="form-label">Full Name</label>
                            <InputText id="name" class="beauty-input w-100" @bind-Value="order.CustomerName" placeholder="e.g. Jane Doe" />
                            <ValidationMessage For="@(() => order.CustomerName)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-3">
                            <label for="address" class="form-label">Street Address</label>
                            <InputText id="address" class="beauty-input w-100" @bind-Value="order.CustomerAddress" placeholder="e.g. 123 Rue de la Beauté, Apt 4" />
                            <ValidationMessage For="@(() => order.CustomerAddress)" class="text-danger small mt-1" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="city" class="form-label">City</label>
                                <InputText id="city" class="beauty-input w-100" @bind-Value="order.CustomerCity" placeholder="e.g. Paris" />
                                <ValidationMessage For="@(() => order.CustomerCity)" class="text-danger small mt-1" />
                            </div>
                            <div class="col-md-6">
                                <label for="province" class="form-label">State / Province</label>
                                <InputText id="province" class="beauty-input w-100" @bind-Value="order.CustomerStateProvince" placeholder="e.g. Île-de-France" />
                                <ValidationMessage For="@(() => order.CustomerStateProvince)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="country" class="form-label">Country</label>
                            <InputText id="country" class="beauty-input w-100" @bind-Value="order.CustomerCountry" placeholder="e.g. France / Vietnam" />
                            <ValidationMessage For="@(() => order.CustomerCountry)" class="text-danger small mt-1" />
                        </div>

                        <div class="d-grid pt-2">
                            <button type="submit" class="btn-beauty-primary btn-beauty-lg">
                                <i class="bi bi-shield-check me-2"></i> Authorize & Place Order • @order.TotalPrice.ToString("c")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Right: Order Items Summary -->
            <div class="col-lg-5">
                <div class="beauty-card p-4 sticky-top" style="top: 96px;">
                    <h4 class="font-serif fs-5 mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                        Order Review (@order.TotalItems items)
                    </h4>

                    <div class="mb-4 max-h-350 overflow-auto pe-1">
                        <OrderLineItemsComponent LineItems="order.LineItems" />
                    </div>

                    <div class="d-flex justify-content-between text-secondary mb-2 small">
                        <span>Delivery</span>
                        <span class="badge" style="background-color: var(--color-success-bg); color: var(--color-success); font-weight: 700;">FREE</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline pt-3 border-top border-secondary border-opacity-15">
                        <span class="fw-bold fs-6">Total Amount</span>
                        <span class="fw-bold fs-3 text-dark font-serif">@order.TotalPrice.ToString("c")</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="beauty-card p-5 text-center my-5">
            <h4 class="font-serif mb-3">Your shopping bag is empty</h4>
            <p class="text-secondary mb-4">Please add items to your cart before proceeding to checkout.</p>
            <NavLink href="products" class="btn-beauty-primary">
                Explore Beauty Products
            </NavLink>
        </div>
    }
</div>

<style>
    .max-h-350 {
        max-height: 350px;
    }
    .text-accent {
        color: var(--color-accent);
    }
</style>

@code {
    private Order? order;

    protected override async Task OnInitializedAsync()
    {
        order = await viewShoppingCartUseCase.Execute();
    }

    private async Task HandlePlaceOrder()
    {
        if (order != null)
        {
            var uniqueId = await placeOrderUseCase.Execute(order);
            if (!string.IsNullOrEmpty(uniqueId))
            {
                navigationManager.NavigateTo($"/orderconfirm/{uniqueId}");
            }
        }
    }
}
