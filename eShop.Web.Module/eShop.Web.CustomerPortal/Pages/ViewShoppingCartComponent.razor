@page "/cart"
@using eShop.CoreBusiness.Models
@using eShop.UseCases.ShoppingCartScreen
@using eShop.Web.CustomerPortal.Controls
@inject IViewShoppingCartUseCase viewShoppingCartUseCase
@inject IUpdateQuantityUseCase updateQuantityUseCase
@inject IDeleteProductUseCase deleteProductUseCase

<div class="beauty-container py-4">
    <!-- Header Row -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 pb-2 border-bottom border-secondary border-opacity-10">
        <div>
            <span class="badge badge-beauty mb-2">My Shopping Bag</span>
            <h1 class="font-serif fs-2 mb-0">Your Beauty Selection</h1>
        </div>
        <NavLink href="products" class="btn-beauty-outline btn-beauty-sm text-decoration-none align-self-start align-self-sm-auto">
            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
        </NavLink>
    </div>

    @if (order != null && order.LineItems != null && order.LineItems.Count > 0)
    {
        <div class="row g-4">
            <!-- Left: Line Items List -->
            <div class="col-lg-8">
                <OrderLineItemsComponent LineItems="order.LineItems" 
                                        OnDeleteProduct="HandleDeleteProduct" 
                                        OnUpdateQuantity="HandleUpdateQuantity" />
            </div>

            <!-- Right: Order Summary Sidebar -->
            <div class="col-lg-4">
                <OrderSummaryComponent Order="order" />
            </div>
        </div>
    }
    else
    {
        <div class="beauty-card p-5 text-center my-5">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center" 
                     style="width: 80px; height: 80px; background-color: var(--color-accent-light); border-radius: 50%;">
                    <i class="bi bi-bag-x fs-1 text-accent"></i>
                </div>
            </div>
            <h3 class="font-serif mb-2">Your Shopping Bag is Empty</h3>
            <p class="text-secondary max-w-400 mx-auto mb-4">
                It looks like you haven't selected any formulas yet. Explore our curated catalog of beauty essentials.
            </p>
            <div>
                <NavLink href="products" class="btn-beauty-primary btn-beauty-lg text-decoration-none">
                    <i class="bi bi-sparkles me-2"></i> Discover Products
                </NavLink>
            </div>
        </div>
    }
</div>

<style>
    .max-w-400 {
        max-width: 420px;
    }
    .text-accent {
        color: var(--color-accent);
    }
</style>

@code {
    private Order? order;

    protected override async Task OnInitializedAsync()
    {
        order = await viewShoppingCartUseCase.Execute();
    }

    private async Task HandleDeleteProduct(int productId)
    {
        order = await deleteProductUseCase.Execute(productId);
    }

    private async Task HandleUpdateQuantity(OrderLineItem item)
    {
        order = await updateQuantityUseCase.Execute(item.ProductId, item.Quantity);
    }
}
