@page "/orderconfirm/{uniqueId}"
@page "/orderconfirmation/{uniqueId}"
@using eShop.CoreBusiness.Models
@using eShop.UseCases.OrderConfirmationScreen
@using eShop.Web.CustomerPortal.Controls
@inject IViewOrderConfirmationUseCase viewOrderConfirmationUseCase

<div class="container py-4">
    @if (order != null)
    {
        <div class="card shadow-sm border-0 p-4">
            <div class="text-center mb-4">
                <div class="text-success mb-2">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <h2 class="fw-bold text-success">Thank You for Your Order!</h2>
                <p class="text-muted">Your order has been placed successfully.</p>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        <h6 class="fw-bold text-secondary mb-2">Order Information</h6>
                        <div><strong>Order ID:</strong> #@order.OrderId</div>
                        <div><strong>Order Reference:</strong> <span class="badge bg-dark font-monospace">@order.UniqueId</span></div>
                        <div><strong>Date Placed:</strong> @order.DatePlaced?.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        <h6 class="fw-bold text-secondary mb-2">Shipping Information</h6>
                        <div><strong>Recipient:</strong> @order.CustomerName</div>
                        <div><strong>Address:</strong> @order.CustomerAddress, @order.CustomerCity</div>
                        <div><strong>State / Country:</strong> @order.CustomerStateProvince, @order.CustomerCountry</div>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold mb-3">Order Details</h5>
            <OrderLineItemsComponent LineItems="order.LineItems" />

            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="fs-5 fw-bold">Total Paid:</span>
                <span class="fs-4 fw-bold text-danger">@order.TotalPrice.ToString("c")</span>
            </div>

            <div class="text-center mt-4">
                <NavLink href="products" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-arrow-left me-2"></i> Continue Shopping
                </NavLink>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            Order could not be found for reference: <strong>@uniqueId</strong>
        </div>
        <NavLink href="products" class="btn btn-secondary">
            Back to Products
        </NavLink>
    }
</div>

@code {
    [Parameter]
    public string? uniqueId { get; set; }

    private Order? order;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!string.IsNullOrEmpty(uniqueId))
        {
            order = viewOrderConfirmationUseCase.Execute(uniqueId);
        }
    }
}
