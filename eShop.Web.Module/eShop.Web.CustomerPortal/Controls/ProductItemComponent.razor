@using eShop.CoreBusiness.Models

@if (Product != null)
{
    <div class="beauty-product-card">
        <!-- Image & Badges Container -->
        <div class="product-img-wrapper">
            <span class="product-wishlist-btn" title="Add to wishlist" @onclick:stopPropagation="true">
                <i class="bi bi-heart"></i>
            </span>
            <NavLink href="@($"/product/{Product.Id}")" class="d-block text-center h-100">
                <img src="@Product.ImageLink" class="product-thumb-img" alt="@Product.Name" loading="lazy" />
            </NavLink>
        </div>

        <!-- Product Content Details -->
        <div class="product-info-wrapper">
            <div class="product-brand-tag">@Product.Brand</div>
            <h4 class="product-title">
                <NavLink href="@($"/product/{Product.Id}")" class="product-title-link">
                    @Product.Name
                </NavLink>
            </h4>

            <div class="product-bottom-row">
                <div class="product-price">
                    @Product.Price.ToString("c")
                </div>
                <NavLink href="@($"/product/{Product.Id}")" class="btn-beauty-outline btn-beauty-sm product-cta">
                    View <i class="bi bi-arrow-right ms-1"></i>
                </NavLink>
            </div>
        </div>
    </div>
}

<style>
    .beauty-product-card {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        height: 100%;
        box-shadow: 0 2px 10px rgba(33, 30, 30, 0.03);
    }

    .beauty-product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 32px rgba(33, 30, 30, 0.08);
        border-color: #E2D7D1;
    }

    .product-img-wrapper {
        background-color: var(--color-surface-subdued);
        position: relative;
        height: 220px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .product-thumb-img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .beauty-product-card:hover .product-thumb-img {
        transform: scale(1.05);
    }

    .product-wishlist-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 34px;
        height: 34px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(4px);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-secondary);
        font-size: 0.95rem;
        cursor: pointer;
        transition: all var(--transition-fast);
        z-index: 2;
    }

    .product-wishlist-btn:hover {
        background: #FFFFFF;
        color: var(--color-accent);
        transform: scale(1.1);
    }

    .product-info-wrapper {
        padding: 1.25rem 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .product-brand-tag {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-bottom: 0.4rem;
    }

    .product-title {
        font-family: var(--font-body);
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.4;
        margin-bottom: 1rem;
        flex-grow: 1;
    }

    .product-title-link {
        color: var(--color-primary);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .product-title-link:hover {
        color: var(--color-accent-hover);
    }

    .product-bottom-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 0.75rem;
        border-top: 1px solid var(--color-border-subtle);
    }

    .product-price {
        font-family: var(--font-body);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: -0.02em;
    }

    .product-cta {
        font-size: 0.8rem;
        padding: 0.35rem 0.85rem;
    }

    .beauty-product-card:hover .product-cta {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: #FFFFFF !important;
    }
</style>

@code {
    [Parameter]
    public Product? Product { get; set; }
}
