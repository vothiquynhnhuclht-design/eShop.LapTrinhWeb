@using eShop.CoreBusiness.Models

@if (LineItems != null && LineItems.Count > 0)
{
    bool isEditable = OnDeleteProduct.HasDelegate || OnUpdateQuantity.HasDelegate;

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="@(isEditable ? "width: 40%;" : "width: 50%;")">Product</th>
                    <th scope="col" class="text-center" style="@(isEditable ? "width: 15%;" : "width: 20%;")">Price</th>
                    <th scope="col" class="text-center" style="@(isEditable ? "width: 20%;" : "width: 15%;")">Quantity</th>
                    <th scope="col" class="text-end" style="@(isEditable ? "width: 15%;" : "width: 15%;")">Total</th>
                    @if (isEditable)
                    {
                        <th scope="col" class="text-center" style="width: 10%;">Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in LineItems)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.Product?.ImageLink))
                                {
                                    <img src="@item.Product.ImageLink" alt="@item.Product.Name" class="img-thumbnail me-3" style="width: 50px; height: 50px; object-fit: contain;" />
                                }
                                <div>
                                    <NavLink href="@($"/product/{item.ProductId}")" class="fw-bold text-decoration-none text-dark">
                                        @(item.Product?.Name ?? $"Product #{item.ProductId}")
                                    </NavLink>
                                    @if (!string.IsNullOrEmpty(item.Product?.Brand))
                                    {
                                        <div class="text-muted small text-capitalize">@item.Product.Brand</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="text-center">@item.Price.ToString("c")</td>
                        <td class="text-center">
                            @if (isEditable)
                            {
                                <div class="d-inline-flex align-items-center justify-content-center">
                                    <input type="number" min="1" class="form-control form-control-sm text-center" style="width: 75px;" 
                                           value="@item.Quantity" 
                                           @onchange="@(e => HandleQuantityChange(item, e))" />
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">@item.Quantity</span>
                            }
                        </td>
                        <td class="text-end fw-bold text-danger">@((item.Price * item.Quantity).ToString("c"))</td>
                        @if (isEditable)
                        {
                            <td class="text-center">
                                <button class="btn btn-outline-danger btn-sm" @onclick="@(() => HandleDelete(item.ProductId))" title="Remove item">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">No items found.</p>
}

@code {
    [Parameter]
    public List<OrderLineItem>? LineItems { get; set; }

    [Parameter]
    public EventCallback<OrderLineItem> OnUpdateQuantity { get; set; }

    [Parameter]
    public EventCallback<int> OnDeleteProduct { get; set; }

    private async Task HandleQuantityChange(OrderLineItem item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int qty) && qty > 0)
        {
            item.Quantity = qty;
            await OnUpdateQuantity.InvokeAsync(item);
        }
    }

    private async Task HandleDelete(int productId)
    {
        await OnDeleteProduct.InvokeAsync(productId);
    }
}
