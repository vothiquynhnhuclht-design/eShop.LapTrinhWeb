@using eShop.CoreBusiness.Models

@if (Order != null)
{
    <div class="beauty-card p-4 sticky-top" style="top: 96px;">
        <h4 class="font-serif fs-5 mb-3 pb-2 border-bottom border-secondary border-opacity-10">
            Order Summary
        </h4>

        <div class="d-flex justify-content-between text-secondary mb-2 small">
            <span>Items Subtotal (@Order.TotalItems)</span>
            <span class="fw-semibold text-dark">@Order.TotalPrice.ToString("c")</span>
        </div>

        <div class="d-flex justify-content-between text-secondary mb-2 small">
            <span>Standard Delivery</span>
            <span class="badge" style="background-color: var(--color-success-bg); color: var(--color-success); font-weight: 700;">FREE</span>
        </div>

        <div class="d-flex justify-content-between text-secondary mb-3 small">
            <span>Estimated Taxes</span>
            <span class="text-muted">Included</span>
        </div>

        <hr class="border-secondary opacity-15 my-3" />

        <div class="d-flex justify-content-between align-items-baseline mb-4">
            <span class="fw-bold fs-6">Estimated Total</span>
            <span class="fw-bold fs-4 text-dark font-serif">@Order.TotalPrice.ToString("c")</span>
        </div>

        <NavLink href="checkout" class="btn-beauty-primary btn-beauty-lg w-100 mb-3 text-decoration-none">
            <i class="bi bi-lock me-2"></i> Proceed to Checkout
        </NavLink>

        <div class="text-center text-muted small">
            <i class="bi bi-shield-lock me-1"></i> Safe & Secure 256-Bit SSL Checkout
        </div>
    </div>
}

@code {
    [Parameter]
    public Order? Order { get; set; }
}
